# Canonical origin for metadata, sitemap and OG tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://abcteknology.com

# App store listings.
# While these are unset, the download badges render a "Coming soon" state
# instead of linking nowhere. Set them only once the listings are live.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
